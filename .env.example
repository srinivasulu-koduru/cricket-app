# Database Credentials
DB_URL=jdbc:mysql://localhost:3306/cricket_app?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-db-password

# Security & JWT Configuration
JWT_SECRET=your-32-character-secret-key-here
JWT_EXPIRATION_MS=86400000

# Real Email SMTP Configuration (Google App Password Setup)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-digit-app-password

# Email Delivery Flag (Set 'true' for real SMTP delivery, 'false' for unit testing)
APP_EMAIL_ENABLED=true
OTP_DEV_LOG_ENABLED=false
